{
  "name": "qr-livre",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:init": "npm run build && npx cap add android && npm run android:ads:configure",
    "android:sync": "npm run build && npx cap sync android && npm run android:ads:configure",
    "android:open": "npx cap open android",
    "android:ads:configure": "node scripts/configure-android-ads.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "lucide-react": "^0.468.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@capacitor-community/admob": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
