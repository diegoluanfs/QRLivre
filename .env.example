# Copie para .env.local (arquivo ignorado pelo Git).
# WEB: mantenha desligado até ter aprovação AdSense e adequar consentimento/privacidade.
VITE_ADSENSE_ENABLED=false
VITE_SHOW_AD_PLACEHOLDERS=true
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_SIDEBAR=
VITE_ADSENSE_SLOT_BOTTOM=
# Copie exatamente a linha ads.txt oferecida pelo AdSense (não é segredo).
# Usada no build para gerar dist/ads.txt; alternativa: public/ads.txt manual.
ADSENSE_ADS_TXT_LINE=

# APP NATIVO: teste usa IDs de demonstração oficiais do Google (não geram receita).
VITE_ADMOB_ENABLED=true
VITE_ADMOB_MODE=test
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_BANNER_ID=
# Preparação para iOS futuro
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_IOS_BANNER_ID=
